# Kong AI Gateway 2.0 — on-call toolkit demo
# source this before running anything:   set -a; source .env; set +a

# Filled in by `kongctl login` / your Konnect AI Gateway id
export AI_GATEWAY_ID="your-ai-gateway-id"    # kongctl get ai-gateways

# MCP endpoint served by the local data plane
export KONNECT_REGION="in"
export MCP_URL="http://localhost:8000/ops-mcp"

export INVESTIGATOR_KEY="inv_generate_your_own"
export OPERATOR_KEY="ops_generate_your_own"

# Generate real keys with:
#   python3 -c "import secrets;print('inv_'+secrets.token_urlsafe(24))"
#   python3 -c "import secrets;print('ops_'+secrets.token_urlsafe(24))"
